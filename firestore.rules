rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidHouse(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 60 &&
             data.code is string && data.code.size() > 0 && data.code.size() <= 30 &&
             data.ownerId is string &&
             data.memberUids is list && data.memberUids.size() <= 20 &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidShoppingList(data) {
      return data.houseId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.icon is string && data.icon.size() <= 10 &&
             data.colorHex is string && data.colorHex.size() <= 16 &&
             data.isArchived is bool &&
             data.memberUids is list && data.memberUids.size() <= 20 &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidShoppingItem(data) {
      return data.listId is string &&
             data.houseId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.category is string && data.category.size() <= 60 &&
             data.itemCount is int && data.itemCount >= 1 &&
             data.isCompleted is bool &&
             data.memberUids is list && data.memberUids.size() <= 20 &&
             (!('quantity' in data) || (data.quantity is string && data.quantity.size() <= 40)) &&
             (!('unitPrice' in data) || (data.unitPrice is number && data.unitPrice >= 0)) &&
             (!('totalPrice' in data) || (data.totalPrice is number && data.totalPrice >= 0)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 300)) &&
             (!('addedByMemberName' in data) || (data.addedByMemberName is string && data.addedByMemberName.size() <= 60)) &&
             (!('addedByUid' in data) || (data.addedByUid is string)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidMember(data) {
      return data.houseId is string &&
             data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 60 &&
             data.avatarColorIndex is int &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidPurchaseHistory(data) {
      return data.houseId is string &&
             data.listName is string && data.listName.size() <= 100 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.totalItemsCount is int && data.totalItemsCount >= 0 &&
             data.memberUids is list && data.memberUids.size() <= 20 &&
             (!('completedByMember' in data) || (data.completedByMember is string && data.completedByMember.size() <= 60)) &&
             (!('timestamp' in data) || (data.timestamp is int || data.timestamp is number)) &&
             (!('createdAt' in data) || (data.createdAt is timestamp && data.createdAt <= request.time));
    }

    match /houses/{houseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.memberUids && isValidHouse(request.resource.data);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.memberUids || request.auth.uid in request.resource.data.memberUids) && isValidHouse(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    match /shopping_lists/{listId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.memberUids && isValidShoppingList(request.resource.data);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.memberUids && isValidShoppingList(request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
    }

    match /shopping_items/{itemId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.memberUids && isValidShoppingItem(request.resource.data);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.memberUids && isValidShoppingItem(request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
    }

    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isValidMember(request.resource.data);
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && isValidMember(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /purchase_history/{historyId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.memberUids && isValidPurchaseHistory(request.resource.data);
      allow update: if isAuthenticated() && request.auth.uid in resource.data.memberUids && isValidPurchaseHistory(request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
    }
  }
}
